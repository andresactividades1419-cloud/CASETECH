# ============================================================
# CASETECH — Variables de entorno (PLANTILLA PÚBLICA)
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores REALES en .env
#   3. NUNCA versiones el archivo .env
#   4. NUNCA uses los valores de esta plantilla en producción
# ============================================================

# --------------- PostgreSQL ---------------
POSTGRES_USER=casetech
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=casetech_db

# --------------- Backend ---------------
DATABASE_URL=postgresql://casetech:CAMBIA_ESTA_CONTRASENA@db:5432/casetech_db

# JWT — Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERA_UNA_CLAVE_ALEATORIA_DE_256_BITS_MINIMO
JWT_ALGORITHM=HS256

# Opciones: development | staging | production
ENVIRONMENT=development

# CORS — Lista separada por comas (sin espacios) de orígenes permitidos
# Ejemplo producción: https://app.casetech.com,https://admin.casetech.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --------------- Seeding inicial (solo development / staging) ---------------
# Contraseña del usuario admin@casetech.com (solo se usa si el usuario NO existe)
# Mínimo 12 caracteres, mayúsculas, minúsculas, números y símbolos
ADMIN_INITIAL_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
# Contraseña del usuario operario@casetech.com
OPERARIO_INITIAL_PASSWORD=CAMBIA_ESTA_CONTRASENA_OPERARIO

# --------------- Frontend ---------------
VITE_API_URL=http://localhost:8000
