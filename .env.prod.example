# ============================================================
# CASETECH ERP — Variables de Entorno para Producción (.env.prod)
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.prod.example .env.prod
#   2. Rellena los valores REALES y seguros en .env.prod
#   3. Ejecuta: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================================

# --------------- Base de Datos PostgreSQL ---------------
POSTGRES_DB=casetech_db
POSTGRES_USER=casetech
POSTGRES_PASSWORD=Genera_Password_Segura_Postgres_2026!

# --------------- Backend FastAPI ---------------
# Generar clave JWT con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=super_secret_production_jwt_key_min_32_bytes_casetech_erp_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
DEBUG=False

# Orígenes CORS permitidos (separados por coma, sin comodín '*')
CORS_ORIGINS=https://app.casetech.com,http://localhost:80

# --------------- Frontend Nginx ---------------
FRONTEND_PORT=80
